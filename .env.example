# Copie este archivo a .env.local para desarrollo.
DATABASE_URL=
PGLITE_DATA_DIR=.local/rerchar-db
STORAGE_DIR=.local/archivos
# Opcional: database para alojar evidencias pequeñas en PostgreSQL (piloto Vercel).
# Si se omite, se usa STORAGE_DIR y un volumen privado persistente.
EVIDENCE_STORAGE=
# URL pública estable para QR y certificados. En producción use HTTPS.
APP_BASE_URL=http://localhost:3000
# Para crear el primer usuario: exporte estas variables sólo durante db:seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
